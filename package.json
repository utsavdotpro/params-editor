{
  "name": "params-editor",
  "version": "1.2.3",
  "description": "A Chrome extension built with TypeScript",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "build:prod": "webpack --config webpack.config.js --mode production --devtool false",
    "bump:version": "node scripts/bump-version.mjs",
    "package:zip": "node scripts/package-extension.mjs",
    "test": "node --experimental-strip-types --test tests/param-reorder.test.mts scripts/version-lib.test.mjs scripts/bump-version.test.mjs scripts/publish-cws.test.mjs scripts/package-extension.test.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "webpack --config webpack.config.js --watch",
    "dev": "webpack serve --config webpack.config.js"
  },
  "dependencies": {
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "autoprefixer": "^10.4.21",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "postcss": "^8.5.3",
    "postcss-loader": "^8.1.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "3",
    "ts-loader": "^9.5.1",
    "webpack": "^5.90.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
